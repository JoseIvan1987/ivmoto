<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Electric-blue accent. Light by default; dark "cockpit" look in night mode. -->
    <style name="Base.Theme.IVMoto" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_orange_dark</item>
        <item name="colorOnPrimaryContainer">@color/on_brand</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>

    <style name="Theme.IVMoto" parent="Base.Theme.IVMoto" />

    <!-- Primary CTA: tall, rounded, confident. Height grows with font scale. -->
    <style name="Widget.IVMoto.Button.Connect" parent="Widget.Material3.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/btn_connect_min_height</item>
        <item name="android:textSize">@dimen/btn_connect_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/btn_icon_padding</item>
    </style>

    <!-- IVMoto home CTA: gradient blue, big and rounded. -->
    <style name="Widget.IVMoto.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Secondary actions: tonal. Icon beside text (not above) so labels stay horizontal. -->
    <style name="Widget.IVMoto.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/btn_tonal_min_height</item>
        <item name="android:textSize">@dimen/btn_tonal_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/btn_icon_padding</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Icon-above tile (Scan / Map / Mirror). Uses auto-size so labels never go vertical. -->
    <style name="Widget.IVMoto.Button.Tile" parent="Widget.IVMoto.Button.Tonal">
        <item name="android:minHeight">@dimen/btn_tile_min_height</item>
        <item name="android:textSize">@dimen/btn_tile_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">@dimen/btn_tile_icon_padding</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">@dimen/btn_tile_text_min</item>
        <item name="autoSizeMaxTextSize">@dimen/btn_tile_text</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Text/ghost actions for the log toolbar. -->
    <style name="Widget.IVMoto.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Segmented-control option (selection highlight is applied in code). -->
    <style name="Widget.IVMoto.Segment" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/btn_segment_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/btn_segment_min_height</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Card.IVMoto" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Card.IVMoto.Log" parent="Card.IVMoto">
        <item name="cardCornerRadius">18dp</item>
        <item name="contentPadding">10dp</item>
    </style>

    <!-- Trip computer stat tiles. -->
    <style name="TripStatLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TripStatValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.IVMoto.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="IVMoto.HomeTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawableTint">@color/ivm_cyan</item>
    </style>
</resources>
