<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/ivm_blue" />
            <stroke android:width="2dp" android:color="@color/ivm_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/surface_high" android:endColor="@color/surface" />
            <stroke android:width="2dp" android:color="@color/outline" />
        </shape>
    </item>
</selector>
